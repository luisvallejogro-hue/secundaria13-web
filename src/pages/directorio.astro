  { nombre: "CARLOS GERARDO RODRÍGUEZ NÚÑEZ", funcion: "Docente" },
  { nombre: "SANTA CONTRERAS QUINTERO (CONTRATO)", funcion: "Docente" },
  { nombre: "DULCE CAROLINA BARRIENTOS ESPINOZA (CONTRATO)", funcion: "Docente" },
  { nombre: "LUIS IGNACIO PÉREZ RIVERA (CONTRATO)", funcion: "Docente" },
  { nombre: "ERIKA GABRIELA MARTÍNEZ GÓMEZ", funcion: "Docente" },
  { nombre: "MAESTRO NUEVO", funcion: "Docente" },
  { nombre: "ARMANDO LOPEZ GARZA", funcion: "Prefecto" },
  { nombre: "EDGAR ISRAEL LEAL SEGURA", funcion: "Administrativo" },
