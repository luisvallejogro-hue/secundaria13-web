---
import '../styles/global.css';

export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Escuela Secundaria No. 13 José María Luis Mora">
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans min-h-screen flex flex-col">
		<header class="bg-blue-900 text-white shadow-md">
			<div class="container mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
				<div class="flex items-center gap-4">
					<img src="/logo.png" alt="Logo Secundaria 13" class="h-12 w-auto drop-shadow-md rounded-full bg-white p-1" />
					<div>
						<h1 class="text-xl font-bold leading-tight">Secundaria No. 13</h1>
						<p class="text-sm text-blue-200">José María Luis Mora</p>
					</div>
				</div>
				<nav class="flex gap-6 font-medium">
					<a href="/" class="hover:text-blue-300 transition">Inicio</a>
					<a href="/directorio" class="hover:text-blue-300 transition">Directorio</a>
					<a href="/galeria" class="hover:text-blue-300 transition">Vida Escolar</a>
				</nav>
			</div>
		</header>
		<main class="flex-grow">
			<slot />
		</main>
		<footer class="bg-gray-800 text-white text-center py-6 mt-12">
			<p class="text-sm text-gray-400">© 2026 Escuela Secundaria No. 13 "José María Luis Mora"</p>
			<p class="text-sm text-gray-400">Calle Olivo S/N, Col. Jardines de la Moderna, Monterrey, N.L. | Tel.- 8183 541117</p>
		</footer>
	</body>
</html>
